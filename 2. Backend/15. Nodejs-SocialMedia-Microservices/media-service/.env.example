PORT=3003

cloud_name=replace-with-your-cloudinary-cloud-name
api_key=replace-with-your-cloudinary-api-key
api_secret=replace-with-your-cloudinary-api-secret

# Also set by docker-compose.yml for the containerized network; only needed
# here if you run this service outside docker-compose.
MONGODB_URI=mongodb://localhost:27017/media-service-db
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
