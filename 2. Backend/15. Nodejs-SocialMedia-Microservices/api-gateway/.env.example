PORT=3000

JWT_SECRET=replace-with-a-long-random-secret

IDENTITY_SERVICE_URL=http://identity-service:3001
POST_SERVICE_URL=http://post-service:3002
MEDIA_SERVICE_URL=http://media-service:3003
SEARCH_SERVICE_URL=http://search-service:3004
LIKE_SERVICE_URL=http://like-service:3005
COMMENT_SERVICE_URL=http://comment-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007
CHAT_SERVICE_URL=http://chat-service:3008

# Also set by docker-compose.yml for the containerized network; only needed
# here if you run this service outside docker-compose.
REDIS_URL=redis://localhost:6379
