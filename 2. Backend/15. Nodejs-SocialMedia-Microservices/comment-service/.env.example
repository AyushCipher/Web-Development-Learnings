PORT=3006

# Also set by docker-compose.yml for the containerized network; only needed
# here if you run this service outside docker-compose.
MONGODB_URI=mongodb://localhost:27017/comment-service-db
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# Base URL comment-service calls internally to verify a post exists before
# allowing a comment on it. docker-compose value: http://post-service:3002
POST_SERVICE_URL=http://localhost:3002
