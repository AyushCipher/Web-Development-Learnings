PORT=3005

# Also set by docker-compose.yml for the containerized network; only needed
# here if you run this service outside docker-compose.
MONGODB_URI=mongodb://localhost:27017/like-service-db
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# Base URL like-service uses to call post-service internally to validate a
# post exists (and find its owner) before recording a like. In docker-compose
# this resolves to the post-service container over the compose network.
POST_SERVICE_URL=http://post-service:3002
