PORT=3008

# Also set by docker-compose.yml for the containerized network; only needed
# here if you run this service outside docker-compose.
MONGODB_URI=mongodb://localhost:27017/chat-service-db

# Must be the SAME secret value identity-service and the api-gateway use in
# real deployment - chat-service verifies the JWTs identity-service issues
# itself (see src/socket/chatSocket.js for why), so a mismatched secret here
# would reject every socket handshake.
JWT_SECRET=your_jwt_secret
