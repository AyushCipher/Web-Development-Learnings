PORT=4000

# Two listeners are exposed by docker-compose.yml's Kafka broker:
#   kafka:29092     - for other containers on the same docker-compose network
#   localhost:9092  - for these Node scripts when you run them directly on
#                     your host machine (the normal way to run this project -
#                     only the broker + Mongo run in Docker, see README.md)
KAFKA_BROKER=localhost:9092

MONGODB_URI=mongodb://localhost:27017/kafka-app-db
